# Copy this file to `.env.local` and fill in your Supabase project values.
# `.env.local` is git-ignored and must never be committed.
#
# These are the ONLY two values the browser is allowed to know. The anon key is a
# public, RLS-gated key — it is NOT the service_role key. Never put the
# service_role key anywhere in the frontend.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Base/display currency for the whole app. Historical FX rates are frozen per
# transaction, so this only affects how unconverted totals are presented.
VITE_BASE_CURRENCY=GBP

# Auto-logout after N minutes of inactivity (0 disables).
VITE_INACTIVITY_TIMEOUT_MINUTES=30
