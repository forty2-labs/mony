# Copy this file to `.env.local`. `.env.local` is git-ignored and must never be
# committed.
#
# Everything prefixed VITE_ is compiled into the public JS bundle, so only the
# project URL and the publishable (public, RLS-gated) key may go here. Never put
# a secret / service_role key anywhere in the frontend.
#
# The values below work as-is for local development (`npm run db:start`): the
# local stack's publishable key is the Supabase CLI's fixed demo key, identical
# on every machine and only valid against 127.0.0.1. Check it with
# `npx supabase status` (PUBLISHABLE_KEY).
#
# For a hosted project, use its URL and publishable key (sb_publishable_…) from
# Dashboard → Project Settings → API Keys.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH

# Public address of the site, used only at build time for link previews
# (Open Graph / Twitter tags), the canonical URL, robots.txt and sitemap.xml.
# Not a VITE_ variable, so it never reaches the JS bundle. Unset = placeholder.
# SITE_URL=https://mony.app
